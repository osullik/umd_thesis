@article{Ahmadi2023,
  title={Inductive and transductive link prediction for criminal network analysis},
  author={Ahmadi,   a and Nguyen, Hoang H and Zhang, Zijian and Bozhkov, Dmytro and Kudenko, Daniel and Jofre, Maria and Calderoni, Francesco and Cohen, Noa and Solewicz, Yosef},
  journal={Journal of Computational Science},
  pages={102063},
  year={2023},
  publisher={Elsevier},
  comments={Case study of using Graph Machine Learning to predict links in criminal networks. They use two logical link prediction methods. Transductive analysis to identify emergent links between nodes (representing criminal offenders or casers) and inductive link prediction where new links are found between existing nodes and a new case. They build their dataset from an Israeli Crime databse, generating embeddings of textual descriptions of the times as well. They generate 3 graphs. Their Crime-Offender network allows vertices to represent crimes or offenders, and the links indicate which offenders participated in those crimes. Their offender network has vertices representing offenders, and edges between offenders are added when they both particiapte in the same crime event. Their 'crime network' assigns crimes to the vertices and created edges between crimes when they share an offender. Transductive links prediction is implemented with a top-k most similar edges based on some similarity metric (like Jaccard). Inductive prediction uses both topological and attribute information for edge prediction. This is the more interesting case of the two. They elect to generate embeddings and feed into a MLP rather than use a GNN because of the scalability issues of GNNs. They transform the original heterogenous graph into two homogenous graphs for their learning phase; future work for them is learning on heterogenous graphs.  }
}

@article{Ji2021a,
  title={A survey on knowledge graphs: Representation, acquisition, and applications},
  author={Ji, Shaoxiong and Pan, Shirui and Cambria, Erik and Marttinen, Pekka and Philip, S Yu},
  journal={IEEE transactions on neural networks and learning systems},
  volume={33},
  number={2},
  pages={494--514},
  year={2021},
  publisher={IEEE},
  comments={Outlines Knowledge Graphs. A knowledge graph is a structured representation of facts, consisting of entities, relationships, and semantic descriptions. Entities can be real-world objects and abstract concepts, relationships represent the relation between entities, and semantic descriptions of entities, and their relationships contain types and properties with a well-defined meaning. Property graphs or attributed graphs are widely used. we define a knowledge graph as G = {E, R, F}, where E, R, and F are sets of entities, relations, and facts,  respectively. A fact is denoted as a triple (h,r,t) ∈ F.}
}

@article{Granovetter1973,
