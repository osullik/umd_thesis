  author={Ahn, Junwhan and Hong, Sungpack and Yoo, Sungjoo and Mutlu, Onur and Choi, Kiyoung},
  booktitle={Proceedings of the 42nd Annual International Symposium on Computer Architecture},
  pages={105--117},
  year={2015},
  comment={Scalable hardware design that can efficently process large graphs in memory is an open problem. 
  PROBLEMS: Two key problems. (1) How fast can each item be processed and request the next item from memory. (2) How fast can the massive amount of data be delivered from memory to computation units. // On-chip accelerators benefit computation efficency but system performance does not scale with the increase in the amount of data per sever (main memory capacity per server) because more accelerators require more memory bandwidth to feed them all. [SCALABILITY is limited by a memory bandwidth bottleneck.]. Graph analysis workloads put pressure on memory bandwidth because of (1) Large number sof random memory accesses across large memory regions, limiting cache efficiency; (2) Very small amounts of computation per item (leading to the inability to hide long memory latencies. //  Many existing frameworks abstract synchronization from the programmers to make parallelism easier. Synchronization is requried to guarantee atomic updates of shared data and no overlap between vertex processign loops. Parallelism is made challenging by (1) Large Number of Random Memory Accesses During Neighbor traversal, (2) Poor locality of memory access in algorithms since many access the entire set of vertices on each iteration of the algorithm. (3) Memory access latency cannot be easily hidden because of small amount of computation per vertex. )
  SOLUTION: Procissing-In-Memory (Tesseract)}
}

@inproceedings{Wang2016,
  title={Gunrock: A high-performance graph processing library on the GPU},
  author={Wang, Yangzihao and Davidson, Andrew and Pan, Yuechao and Wu, Yuduo and Riffel, Andy and Owens, John D},
  booktitle={Proceedings of the 21st ACM SIGPLAN symposium on principles and practice of parallel programming},
  pages={1--12},
  year={2016}, 
  groups={graph_datasets},
  abstract={For large-scale graph analytics on the GPU, the irregularity of data access/control flow and the complexity of programming GPUs have been two significant challenges for developing a programmable high-performance graph library. "Gunrock," our high-level bulk-synchronous graph-processing system targeting the GPU, takes a new approach to abstracting GPU graph analytics: rather than designing an abstraction around computation, Gunrock instead implements a novel data-centric abstraction centered on operations on a vertex or edge frontier. Gunrock achieves a balance between performance and expressiveness by coupling high-performance GPU computing primitives and optimization strategies with a high-level programming model that allows programmers to quickly develop new graph primitives with small code size and minimal GPU programming knowledge. We evaluate Gunrock on five graph primitives (BFS, BC, SSSP, CC, and PageRank) and show that Gunrock has on average at least an order of magnitude speedup over Boost and PowerGraph, comparable performance to the fastest GPU hardwired primitives, and better performance than any other GPU high-level graph library.},
  comment={GOOD SOURCE FOR RELATED WORK ON GRAPH OPTIMIZATION.
    PROBLEMS: (1) Irregularity of data access/control flow in graph data structures make implemeing on GPU optimized for regular structured parallelism difficult. (2) The Chief challenge in a massively parallel Graph Processing system is managing irregularity in workload distribution.
  SOLUTIONS:
  METHOD: "Our Key abstraction is the frontier, a sobset of the edges or vertices within the graph that are currently of interest. All Gunrock operations are bulk-synchronous and manipulate this frontier, either by computing on values within it or computing a new frontier from it".
  PRIMITIVES:BFS, SSSP, BC, PageRank, CC (Comment: I don't hold these as primitives. Do all of these compose into more complicated algorithms?)}
}


@inproceedings{Mukkara2018,
  title={Exploiting locality in graph analytics through hardware-accelerated traversal scheduling},
  author={Mukkara, Anurag and Beckmann, Nathan and Abeydeera, Maleen and Ma, Xiaosong and Sanchez, Daniel},
  booktitle={2018 51st Annual IEEE/ACM International Symposium on Microarchitecture (MICRO)},
  pages={1--14},
  year={2018},
  organization={IEEE},
  comments={PROBLEMS: (1) Caches are of little help because of the irregular structure of graph causes seemingly random memory references. Three factors conspire to make graph applications memory-boung (a) low compute-to-communication ratio. (b) Poor Temporal locality because of graph structure. (c) Poor spatial locality as they perform spare accesses to small (4-8 Byte objects). // Software frameworks (like Ligra and Graph-MAT) process vertices in the order they are found in memory (vertex-ordered scheduling) because typically online traversal scheduling incurs too much cost and it makes sense for most applications on general-purpose systems. Offline traversal scheduling occurs (Graphicionado, PathGraph, GridGraph) but is very expensieve and so only really works for static graphs. 
  ASSERTION: Most real-world graphs offer significant potential locality, it is just hard to predict ahead of time. Locality can be exploited by controlling the traversal schedule (order in which vertices and edges of the graph are processed)
  SOLUTION: Online traversal scheduling stretegies that exploit the community structure of real-world graphs to improve locality (temporal). They use hardware acceleration to speed up the traversal scheduling aspect. }
}

