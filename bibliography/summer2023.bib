@article{Bhattacharya2006,
  title={Entity resolution in graphs},
  author={Bhattacharya, Indrajit and Getoor, Lise},
  journal={Mining graph data},
  volume={311},
  year={2006},
  publisher={Wiley Hoboken, NJ},
  comments={The goal of entity resolution is to reconcile data references corresponding to the same real world entity... the nodes are the references in the data and the hyper edges are the relations observed to hold between the references... They formulate the graph entity resolution problem as an unsupervised clustering task where each cluster represents references that map to the same entity and the similarity measure between two clusters ... measures the similarities between the relations of two entities. In the entity resolution problem we have a set of references R, each of which has their set of attributess A. There is a set of entites E and each reference r has a hidden entity e. We are given a set of hyper edges H and each reference r is labelled a member of a hyper edge in H. The similarity of entites is calculated using either edge-detail similarity (checking the detail of the labels of each edge in which an entity participates) or neighbourhood similarity which collpses just the local neighbourhood for local entity cluster. Execution times are highly dependent on the structure of the input graph.}
}

@article{Zhang2020,
  title={Unsupervised entity resolution with blocking and graph algorithms},
  author={Zhang, Dongxiang and Li, Dongsheng and Guo, Long and Tan, Kian-Lee},
  journal={IEEE Transactions on Knowledge and Data Engineering},
  volume={34},
  number={3},
  pages={1501--1515},
  year={2020},
  publisher={IEEE},
  comments={Entity resolution identifies all records in a database that refer to the same entity. Uses Iterative Term Entity Ranking which uses a bipartite graph to model the relationships between terms and record-record pairs. They use random walks to develop the CliqueRank (cubic complexity) algorithm for calculating the similarity of two records. ITER (term based similarity) and CliqueRank (topoligical confidence) are applied iteratively. Blocking is an approximate technique to improve the efficiency of large-scale entity resolution. It clusters similar records into blocks and only executes comparison for record pairs within the same block. Blocking mitigates the impact of the cubic complexity of CliqueRank. It's a graph-theoretic approach rather than being ML based.}
}

